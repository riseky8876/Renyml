<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/pill_selected_bg" />
            <stroke android:width="1dp" android:color="@color/furina_blue" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFD0E5FF" />
            <stroke android:width="1dp" android:color="@color/furina_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/pill_default_bg" />
            <stroke android:width="1dp" android:color="#FFB0CFF0" />
        </shape>
    </item>
</selector>
