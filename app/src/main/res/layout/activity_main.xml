<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ========== HEADER BANNER ========== -->
            <FrameLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <ImageView
                    android:id="@+id/headerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/header_default"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/header_gradient" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_status_ok"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/status_ok"
                        android:textColor="@color/status_ok"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/deviceInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- ========== CONTENT AREA ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.6">

                    <!-- ========== TAB MAIN ========== -->
                    <ScrollView
                        android:id="@+id/panelMain"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- 2x2 grid via two rows -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/btnRunEsp"
                                    android:layout_width="0dp"
                                    android:layout_height="118dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/btn_action"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_run"
                                        android:contentDescription="@null" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:gravity="center"
                                        android:text="@string/btn_run_esp"
                                        android:textColor="@color/text_primary"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="opsi 1"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnRunNoEsp"
                                    android:layout_width="0dp"
                                    android:layout_height="118dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/btn_action"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_run"
                                        android:contentDescription="@null" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:gravity="center"
                                        android:text="@string/btn_run_no_esp"
                                        android:textColor="@color/text_primary"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="opsi 2"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/btnRestore"
                                    android:layout_width="0dp"
                                    android:layout_height="118dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/btn_action"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_restore"
                                        android:contentDescription="@null" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:gravity="center"
                                        android:text="@string/btn_restore"
                                        android:textColor="@color/text_primary"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="opsi 3"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnFreeze"
                                    android:layout_width="0dp"
                                    android:layout_height="118dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/btn_action"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_freeze"
                                        android:contentDescription="@null" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:gravity="center"
                                        android:text="@string/btn_freeze"
                                        android:textColor="@color/text_primary"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="opsi 4"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/runProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="10dp"
                                android:visibility="gone"
                                android:indeterminateTint="@color/furina_blue" />
                        </LinearLayout>
                    </ScrollView>

                    <!-- ========== TAB NETWORK ========== -->
                    <ScrollView
                        android:id="@+id/panelNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- WiFi card -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/card_bg"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:id="@+id/hdrWifi"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:src="@drawable/ic_tab_network"
                                        app:tint="@color/furina_blue"
                                        android:contentDescription="@null"
                                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="10dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/net_wifi"
                                            android:textColor="@color/text_primary"
                                            android:textSize="15sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/wifiSubtitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Tap untuk pilih preset"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/arrowWifi"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="▼"
                                        android:textColor="@color/furina_blue"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/bodyWifi"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="vertical">

                                    <!-- Preset pills row 1 -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <include
                                            android:id="@+id/pillWifiGaming"
                                            layout="@layout/preset_pill_gaming"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginEnd="6dp" />

                                        <include
                                            android:id="@+id/pillWifiDownload"
                                            layout="@layout/preset_pill_download"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginStart="6dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:orientation="horizontal">

                                        <include
                                            android:id="@+id/pillWifiStreaming"
                                            layout="@layout/preset_pill_streaming"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginEnd="6dp" />

                                        <include
                                            android:id="@+id/pillWifiUpload"
                                            layout="@layout/preset_pill_upload"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginStart="6dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:orientation="horizontal">

                                        <Button
                                            android:id="@+id/btnWifiApply"
                                            android:layout_width="0dp"
                                            android:layout_height="44dp"
                                            android:layout_weight="2"
                                            android:layout_marginEnd="6dp"
                                            android:background="@drawable/btn_glow"
                                            android:text="@string/net_apply"
                                            android:textAllCaps="false"
                                            android:textColor="#FFFFFF"
                                            android:textStyle="bold" />

                                        <Button
                                            android:id="@+id/btnWifiRevert"
                                            style="@style/SecondaryBtn"
                                            android:layout_width="0dp"
                                            android:layout_weight="1"
                                            android:layout_marginStart="6dp"
                                            android:text="@string/net_revert" 
                                            android:textColor="#FFFFFF"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Cell card -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/card_bg"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:id="@+id/hdrCell"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:src="@drawable/ic_tab_network"
                                        app:tint="@color/furina_blue"
                                        android:contentDescription="@null"
                                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="10dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/net_cell"
                                            android:textColor="@color/text_primary"
                                            android:textSize="15sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/cellSubtitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Tap untuk pilih preset"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/arrowCell"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="▶"
                                        android:textColor="@color/furina_blue"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/bodyCell"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <include
                                            android:id="@+id/pillCellGaming"
                                            layout="@layout/preset_pill_gaming"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginEnd="6dp" />

                                        <include
                                            android:id="@+id/pillCellDownload"
                                            layout="@layout/preset_pill_download"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginStart="6dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:orientation="horizontal">

                                        <include
                                            android:id="@+id/pillCellStreaming"
                                            layout="@layout/preset_pill_streaming"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginEnd="6dp" />

                                        <include
                                            android:id="@+id/pillCellUpload"
                                            layout="@layout/preset_pill_upload"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginStart="6dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:orientation="horizontal">

                                        <Button
                                            android:id="@+id/btnCellApply"
                                            android:layout_width="0dp"
                                            android:layout_height="44dp"
                                            android:layout_weight="2"
                                            android:layout_marginEnd="6dp"
                                            android:background="@drawable/btn_glow"
                                            android:text="@string/net_apply"
                                            android:textAllCaps="false"
                                            android:textColor="#FFFFFF"
                                            android:textStyle="bold" />

                                        <Button
                                            android:id="@+id/btnCellRevert"
                                            style="@style/SecondaryBtn"
                                            android:layout_width="0dp"
                                            android:layout_weight="1"
                                            android:layout_marginStart="6dp"
                                            android:text="@string/net_revert" 
                                            android:textColor="#FFFFFF"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Lainnya card -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/card_bg"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:id="@+id/hdrOther"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:src="@drawable/ic_status"
                                        android:contentDescription="@null" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="10dp"
                                        android:text="@string/net_other"
                                        android:textColor="@color/text_primary"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/arrowOther"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="▶"
                                        android:textColor="@color/furina_blue"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/bodyOther"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <Button
                                        android:id="@+id/btnNetStatus"
                                        style="@style/SecondaryBtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="44dp"
                                        android:layout_marginBottom="8dp"
                                        android:text="@string/net_status" 
                                            android:textColor="#FFFFFF"/>

                                    <Button
                                        android:id="@+id/btnNetRestore"
                                        android:layout_width="match_parent"
                                        android:layout_height="44dp"
                                        android:background="@drawable/btn_glow"
                                        android:text="@string/net_restore"
                                        android:textAllCaps="false"
                                        android:textColor="#FFFFFF"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </FrameLayout>

                <!-- ========== LOG (shared) ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/log_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/log_title"
                            android:textColor="@color/furina_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnClearLog"
                            style="@style/SecondaryBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/log_clear"
                            android:textSize="11sp" 
                                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/logScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:fadeScrollbars="false">

                        <TextView
                            android:id="@+id/logView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="@string/log_empty"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </ScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/log_path_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== BOTTOM TAB BAR ========== -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_nav_bg"
                app:itemIconTint="@color/bottom_nav_color"
                app:itemTextColor="@color/bottom_nav_color"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />
        </LinearLayout>

        <!-- Avatar fixed top-left -->
        <ImageButton
            android:id="@+id/avatarBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="14dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/menu_settings"
            android:scaleType="fitCenter"
            android:src="@drawable/furina" />
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFFFF"
        android:fitsSystemWindows="true"
        app:itemTextColor="@color/text_primary"
        app:itemIconTint="@color/furina_blue"
        app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
