<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status bar -->
        <TextView android:id="@+id/tvRootStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="13sp"
            android:background="#22000000"
            android:layout_marginBottom="6dp"/>

        <TextView android:id="@+id/tvUsageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="13sp"
            android:background="#22000000"
            android:layout_marginBottom="12dp"/>

        <!-- Master enable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aktifkan Smart Profile"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <Switch android:id="@+id/switchSmartEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- GAMING PROFILE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎮  Gaming Profile"
            android:textColor="@color/furina_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CPU Governor" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <Spinner android:id="@+id/spinGamingGov"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GPU Min Freq (Hz, kosongkan jika tidak ingin diubah)"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <EditText android:id="@+id/etGamingGpuMin"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="misal: 400000000"
                android:inputType="number"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Aplikasi Pemicu (Gaming otomatis aktif saat buka app ini)"
                android:textColor="@color/text_secondary" android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <LinearLayout android:id="@+id/llGamingApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btnAddGameApp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+ Tambah Aplikasi Game"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_glow"/>
        </LinearLayout>

        <!-- CHARGING PROFILE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡  Charging Profile"
            android:textColor="@color/furina_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CPU Governor" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <Spinner android:id="@+id/spinChargingGov"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <CheckBox android:id="@+id/cbRelaxThermal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Longgarkan batas thermal saat charging"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- IDLE PROFILE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💤  Idle Profile"
            android:textColor="@color/furina_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CPU Governor" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <Spinner android:id="@+id/spinIdleGov"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GPU Max Freq (Hz, kosongkan jika tidak ingin diubah)"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <EditText android:id="@+id/etIdleGpuMax"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="misal: 200000000"
                android:inputType="number"
                android:layout_marginBottom="12dp"/>

            <CheckBox android:id="@+id/cbIdleScreenOff"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Hanya aktif saat layar mati"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- MANUAL PROFILE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎛️  Manual Profile"
            android:textColor="@color/furina_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CPU Governor" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <Spinner android:id="@+id/spinManualGov"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GPU Min Freq (Hz)" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <EditText android:id="@+id/etManualGpuMin"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="kosong = tidak diubah" android:inputType="number"
                android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GPU Max Freq (Hz)" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <EditText android:id="@+id/etManualGpuMax"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="kosong = tidak diubah" android:inputType="number"/>
        </LinearLayout>

        <!-- Save -->
        <Button android:id="@+id/btnSaveSmartProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Simpan Semua"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/btn_glow"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
