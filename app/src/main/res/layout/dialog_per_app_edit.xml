<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:id="@+id/dialogAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/furina_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- CPU Governor -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CPU Governor"
            android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <Spinner android:id="@+id/spinPerAppGov"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- GPU Min -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="GPU Min Freq (Hz, kosong = tidak diubah)"
            android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <EditText android:id="@+id/etPerAppGpuMin"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="misal: 400000000" android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <!-- GPU Max -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="GPU Max Freq (Hz, kosong = tidak diubah)"
            android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <EditText android:id="@+id/etPerAppGpuMax"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="misal: 700000000" android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <!-- Network Priority -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Prioritas Jaringan"
            android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <Spinner android:id="@+id/spinPerAppNet"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
