<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_bg">

    <ImageView android:id="@+id/perAppIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/perAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView android:id="@+id/perAppPackage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"/>

        <TextView android:id="@+id/perAppSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/furina_blue"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <ImageView android:id="@+id/perAppEdit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_edit"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="4dp"/>

    <ImageView android:id="@+id/perAppRemove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_delete"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>

</LinearLayout>
