<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GenshinPerf" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/furina_blue</item>
        <item name="colorPrimaryVariant">@color/furina_cyan</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorAccent">@color/furina_blue</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="21">#FFFFFF</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Theme.GenshinPerf.Splash" parent="Theme.GenshinPerf">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
